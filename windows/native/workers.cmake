find_package(Qt6 6.4 REQUIRED COMPONENTS Core Gui OpenGL)
find_package(Vulkan REQUIRED)
find_program(GLSLANG NAMES glslangValidator glslang REQUIRED)
set(CMAKE_AUTOMOC ON)
foreach(stage vert frag)
 add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/city.${stage}.spv COMMAND ${GLSLANG} -V ${CMAKE_CURRENT_SOURCE_DIR}/shaders/city.${stage} -o ${CMAKE_CURRENT_BINARY_DIR}/city.${stage}.spv DEPENDS shaders/city.${stage} VERBATIM)
endforeach()
set(COMPUTE_SPV)
foreach(kernel copy write read fp32 fp64 int32 int64)
 add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${kernel}.comp.spv COMMAND ${GLSLANG} -V ${CMAKE_CURRENT_SOURCE_DIR}/shaders/${kernel}.comp -o ${CMAKE_CURRENT_BINARY_DIR}/${kernel}.comp.spv DEPENDS shaders/${kernel}.comp VERBATIM)
 list(APPEND COMPUTE_SPV ${CMAKE_CURRENT_BINARY_DIR}/${kernel}.comp.spv)
endforeach()
add_custom_target(shaders DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/city.vert.spv ${CMAKE_CURRENT_BINARY_DIR}/city.frag.spv ${COMPUTE_SPV})
add_library(windows-worker-core STATIC src/model.cpp src/repository.cpp src/nvml_offsets.cpp src/gpu_tuning.cpp windows/native/qt_backend.cpp)
target_include_directories(windows-worker-core PUBLIC src windows/native)
target_link_libraries(windows-worker-core PUBLIC gpupro-common gpupro-native Qt6::Core dxgi winsqlite3)
add_executable(gpu-bench-worker src/render_worker.cpp)
target_link_libraries(gpu-bench-worker PRIVATE windows-worker-core Qt6::Gui Qt6::OpenGL Vulkan::Vulkan)
add_dependencies(gpu-bench-worker shaders)
qt_add_resources(gpu-bench-worker worker-shaders PREFIX /shaders BASE ${CMAKE_CURRENT_BINARY_DIR} FILES ${CMAKE_CURRENT_BINARY_DIR}/city.vert.spv ${CMAKE_CURRENT_BINARY_DIR}/city.frag.spv ${COMPUTE_SPV})
qt_add_resources(gpu-bench-worker worker-source PREFIX /source BASE ${CMAKE_CURRENT_SOURCE_DIR}/shaders FILES shaders/city.frag)
add_executable(gpu-video-worker src/video_worker.cpp src/codec.cpp src/codec_suite.cpp)
target_link_libraries(gpu-video-worker PRIVATE windows-worker-core)
install(TARGETS gpu-bench-worker gpu-video-worker gpupro-native RUNTIME DESTINATION .)

add_executable(gpu-data-worker windows/native/data_worker.cpp)
target_link_libraries(gpu-data-worker PRIVATE windows-worker-core)

add_executable(gpu-tuning-worker windows/native/tuning_worker.cpp)
target_link_libraries(gpu-tuning-worker PRIVATE windows-worker-core shell32 user32)

# Configurações 3D globais do driver NVIDIA (DRS). Sem Qt; executado elevado só para gravar.
add_executable(gpu-3d-worker windows/native/driver3d_worker.cpp)
target_compile_definitions(gpu-3d-worker PRIVATE UNICODE _UNICODE NOMINMAX)
install(TARGETS gpu-3d-worker RUNTIME DESTINATION .)

# Contador de quadros (ETW) para o FPS dos jogos, sem programas externos. CRT estático: o serviço
# é copiado sozinho para Arquivos de Programas e não depende das DLLs da pasta do aplicativo.
add_executable(gpupro-frames windows/native/frame_service.cpp)
target_compile_definitions(gpupro-frames PRIVATE UNICODE _UNICODE NOMINMAX)
set_property(TARGET gpupro-frames PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded")
target_link_libraries(gpupro-frames PRIVATE advapi32 shell32)
install(TARGETS gpupro-frames RUNTIME DESTINATION .)
