#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer Input {uint data[];} inputData;
layout(set=0,binding=1,std430) buffer Output {uint data[];} outputData;
layout(push_constant) uniform Params {uint count;uint iterations;uint seed;} params;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=params.count)return;double a=double(uintBitsToFloat(inputData.data[i])),b=a,c=a,d=a;for(uint j=0u;j<params.iterations;++j){a=fma(a,1.000001lf,0.000001lf);b=fma(b,0.999999lf,0.000002lf);c=fma(c,1.000002lf,0.000003lf);d=fma(d,0.999998lf,0.000004lf);}uvec2 bits=unpackDouble2x32(a+b+c+d);outputData.data[2u*i]=bits.x;outputData.data[2u*i+1u]=bits.y;}
