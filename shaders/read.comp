#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer Input {uint data[];} inputData;
layout(set=0,binding=1,std430) buffer Output {uint data[];} outputData;
layout(push_constant) uniform Params {uint count;uint iterations;uint seed;} params;
shared uint values[256];
void main(){uint i=gl_GlobalInvocationID.x,j=gl_LocalInvocationID.x;values[j]=i<params.count?inputData.data[i]:0u;barrier();for(uint step=128u;step>0u;step>>=1u){if(j<step)values[j]+=values[j+step];barrier();}if(j==0u)outputData.data[gl_WorkGroupID.x]=values[0]+params.seed;}
