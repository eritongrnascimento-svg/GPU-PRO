#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer Input {uint data[];} inputData;
layout(set=0,binding=1,std430) buffer Output {uint data[];} outputData;
layout(push_constant) uniform Params {uint count;uint iterations;uint seed;} params;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=params.count)return;outputData.data[i]=inputData.data[i]+params.seed;}
